{
  "name": "@sundown/web",
  "private": true,
  "version": "0.0.0",
  "description": "Sundown UI: risk evidence and replay (research simulation) plus read-only views of the Arbitrum Sepolia deployment (simulated tokens and feeds)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "export-data": "cd ../research && .venv/bin/python export_web_data.py",
    "export-abis": "node scripts/export-abis.mjs",
    "export-chain": "node scripts/export-chain-data.mjs",
    "check-chain": "node scripts/export-abis.mjs --check && node scripts/export-chain-data.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "@rainbow-me/rainbowkit": "^2.2.0",
    "@tanstack/react-query": "^5.80.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "viem": "^2.31.0",
    "wagmi": "^2.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
