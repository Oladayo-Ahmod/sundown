# Copy to .env (never commit .env). RPC URLs may embed provider API keys.
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deployer key: use a throwaway key. Never commit a real key.

# Block explorer verification (Blockscout needs no key)
ROBINHOOD_BLOCKSCOUT_API=https://robinhoodchain.blockscout.com/api/

# Deployments use a cast keystore, never a raw key in the environment or in logs:
#   cast wallet import <name> --interactive          (then pass --account <name> --password-file <file> to forge/cast)
# The password file lives outside the repository (for example ~/.secrets/sepolia.pass, mode 600).
# Address of the demonstration guardian (a different key from the deployer):
SUNDOWN_GUARDIAN=
# Etherscan v2 key (one key covers Arbiscan Sepolia); used for contract verification:
ETHERSCAN_API_KEY=
