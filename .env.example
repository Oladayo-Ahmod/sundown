# Copy to .env (never commit .env). RPC URLs may embed provider API keys.
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deployer key: use a throwaway key. Never commit a real key.
DEPLOYER_PRIVATE_KEY=

# Block explorer verification (Blockscout needs no key)
ROBINHOOD_BLOCKSCOUT_API=https://robinhoodchain.blockscout.com/api/
ARBISCAN_API_KEY=
